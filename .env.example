# Copy values into user-secrets (development) or your host's secret store (production). Never commit real values.
#   dotnet user-secrets --project src/Maijichain.WebHost set "Line:ChannelSecret" "<value>"
# Environment-variable form (double underscore = section separator):
Line__ChannelSecret=
Line__ChannelAccessToken=
# 32+ random characters, e.g. from: openssl rand -base64 48
Line__IdentityPepper=
# Optional: your bot's user ID; webhooks for any other destination are rejected
Line__BotUserId=
Line__MonthlyPushBudget=150
DataDirectory=data

# Bitcoin POC regtest test (optional)
MAIJICHAIN_REGTEST_RPC=maiji:<rpcpassword>@127.0.0.1:18443
